# DeFi Guardian Environment Configuration

# Backend Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Hyperliquid API (Official Public Endpoint)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info

# Optional CoinGecko Demo API (Leave empty for pure Hyperliquid mode)
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Database Path
DATABASE_PATH=defi_guardian.db

# Optional Public Wallet to Monitor (e.g., 0x...)
PUBLIC_WALLET_ADDRESS=

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]
