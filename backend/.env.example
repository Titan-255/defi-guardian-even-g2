# DeFi Guardian Backend Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Hyperliquid API (Official Public Info Endpoint)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info

# Optional CoinGecko Demo API (Leave empty if not using)
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Database
DATABASE_URL=sqlite:///./defi_guardian.db

# Optional Public Wallet to Monitor (e.g., 0x...)
PUBLIC_WALLET_ADDRESS=

# CORS Settings (allow local frontend and Even Hub simulator)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]
